post_install() {
    # Bash completion — always install
    mkdir -p /etc/bash_completion.d/
    /opt/bin/dtools completion bash > /etc/bash_completion.d/dtools

    # Zsh completion — only if zsh is present
    if command -v zsh > /dev/null 2>&1; then
        mkdir -p /usr/share/zsh/site-functions
        /opt/bin/dtools completion zsh > /usr/share/zsh/site-functions/_dtools
        # Rebuild zsh completion cache for all users
        zsh -c 'autoload -Uz compinit && compinit' 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /etc/bash_completion.d/dtools
    rm -f /usr/share/zsh/site-functions/_dtools
}
